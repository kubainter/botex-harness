# Bielik-11B-v3.1-Instruct (Q4_K_M, ~6.26 GiB) served by llama.cpp.
# Background one-shot LLM: chat auto-titler, Memory Vault compaction,
# intent classification, privacy pre-flight, Oracle Reclamation Shield.
# Install: /etc/systemd/system/bielik.service
[Unit]
Description=Bielik-11B-v3.1 (Q4_K_M) llama.cpp inference server
Documentation=https://github.com/speakleash/Bielik-11B-v3.1-Instruct
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botex
Group=botex

# Adjust paths to your build and model file (see README.md).
Environment=BIELIK_BIN=/opt/llama.cpp/build/bin/llama-server
Environment=BIELIK_MODEL=/opt/bielik/models/Bielik-11B-v3.1-instruct.Q4_K_M.gguf

# -c 8192: 8k context for Memory Vault compaction & local Polish chat.
# Loopback only: consumed by BoteX on the same host, never exposed publicly.
# --load-mode mmap+mlock keeps the model resident (backed by LimitMEMLOCK=infinity).
ExecStart=/opt/llama.cpp/build/bin/llama-server --model /opt/bielik/models/Bielik-11B-v3.1-instruct.Q4_K_M.gguf --host 127.0.0.1 --port 8080 -c 8192 --threads 2 --load-mode mmap+mlock

Restart=on-failure
RestartSec=10

# OCPUs 1-2 at idle scheduling priority: inference yields to BoteX (OCPU 0)
# and to any regular-priority work on its own cores.
CPUAffinity=1-2
CPUSchedulingPolicy=idle
CPUWeight=1
Nice=19
IOSchedulingClass=idle
IOWeight=7

# Model ~6.26 GiB + 8k context + runtime scratch (~8.5 GiB total, safe in 18 GiB RAM).
MemoryMax=10G
LimitMEMLOCK=infinity

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/bielik
ProtectHome=true

SyslogIdentifier=bielik

[Install]
WantedBy=multi-user.target
