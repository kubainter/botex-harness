# BoteX Local LLM Router (Bielik-11B-v3.1 + passive on-demand models via llama.cpp).
# Background one-shot LLM: chat auto-titler, Memory Vault compaction,
# intent classification, privacy pre-flight, Oracle Reclamation Shield.
# Install: /etc/systemd/system/bielik.service
[Unit]
Description=BoteX Local LLM Router (llama.cpp, max 1 model in RAM)
Documentation=https://github.com/speakleash/Bielik-11B-v3.1-Instruct
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botex
Group=botex

# Adjust paths to your build and models directory (see README.md).
Environment=BIELIK_BIN=/opt/llama.cpp/build/bin/llama-server
Environment=BIELIK_MODELS_DIR=/opt/bielik/models

# Router mode: serves all GGUFs in /opt/bielik/models with --models-max 1 so
# switching between Bielik and Qwen happens passively on request without OOM.
# --load-mode mmap lets the kernel page cache retain pages across swaps.
ExecStart=/opt/llama.cpp/build/bin/llama-server --models-dir /opt/bielik/models --models-preset /opt/botex/deploy/oracle-vps/models-preset.ini --models-max 1 --models-autoload --host 127.0.0.1 --port 8080 -c 8192 --threads 4 --load-mode mmap

Restart=on-failure
RestartSec=10

# All 4 OCPUs at idle scheduling priority: inference still yields to any
# regular-priority work (CPUSchedulingPolicy=idle is the real protection),
# while scaling is near-linear on this Ampere hardware — measured llama-bench
# 2026-11-25: pp 5.53/8.18/10.92 tok/s and tg 2.42/3.60/4.59 tok/s at 2/3/4
# threads. Nighttime drain batches halve from ~25 min to ~12 min.
CPUAffinity=0-3
CPUSchedulingPolicy=idle
CPUWeight=1
Nice=19
IOSchedulingClass=idle
IOWeight=7

# Model ~6.26 GiB + 8k context + runtime scratch (~8.5 GiB total, safe in 18 GiB RAM).
MemoryMax=10G
LimitMEMLOCK=infinity

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/bielik
ProtectHome=true

SyslogIdentifier=bielik

[Install]
WantedBy=multi-user.target
