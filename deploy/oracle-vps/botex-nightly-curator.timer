# Fires botex-nightly-curator.service once daily at 03:30 AM
# Install: /etc/systemd/system/botex-nightly-curator.timer
# Enable:  systemctl enable --now botex-nightly-curator.timer
[Unit]
Description=Nightly BoteX Knowledge Graph Curation and Memory Audit Timer
Documentation=https://github.com/kubainter/botex-harness

[Timer]
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=180
Persistent=true

[Install]
WantedBy=timers.target
