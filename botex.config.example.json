{
  "providers": {
    "openrouter": {
      "api_key_env": "OPENROUTER_API_KEY",
      "extra_body": {
        "reasoning": {
          "max_tokens": 9000
        }
      },
      "models": {
        "review": "z-ai/glm-4.6",
        "fast": "openai/gpt-4o-mini"
      },
      "model_fallbacks": {
        "default": [
          "z-ai/glm-4.6",
          "qwen/qwen3-coder",
          "deepseek/deepseek-v3.2"
        ],
        "auto-beta": [
          "z-ai/glm-4.6",
          "qwen/qwen3-coder",
          "deepseek/deepseek-v3.2"
        ],
        "coding": [
          "z-ai/glm-4.6",
          "qwen/qwen3-coder",
          "deepseek/deepseek-v3.2"
        ],
        "review": [
          "moonshotai/kimi-k2",
          "deepseek/deepseek-v3.2",
          "qwen/qwen3-coder"
        ],
        "fast": [
          "qwen/qwen3-coder",
          "deepseek/deepseek-v3.2",
          "z-ai/glm-4.6"
        ]
      }
    },
    "nvidia": {
      "api_key_env": "NVIDIA_API_KEY",
      "models": {
        "default": "nvidia/nemotron-3-ultra-550b-a55b",
        "coding": "poolside/laguna-xs-2.1",
        "fast": "nvidia/nemotron-3.5-lightning-30b-a3b"
      }
    },
    "openrouter-free": {
      "api_key_env": "OPENROUTER_API_FREE_KEY",
      "extra_body": {
        "reasoning": {
          "max_tokens": 4000
        }
      },
      "models": {
        "fast": "nvidia/nemotron-3.5-lightning:free"
      },
      "model_fallbacks": {
        "default": [
          "nvidia/nemotron-3.5-lightning:free",
          "nvidia/nemotron-3.5-super-vl:free"
        ],
        "coding": [
          "nvidia/nemotron-3.5-super-vl:free",
          "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"
        ],
        "fast": [
          "nvidia/nemotron-3.5-super-vl:free",
          "nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"
        ]
      }
    },
    "google": {
      "api_key_env": "GEMINI_API_KEY",
      "capabilities": {
        "gemini-3-flash-preview": {
          "supports_tools": true,
          "context_length": 1048576
        }
      },
      "models": {
        "coding": "gemini-2.5-flash"
      },
      "model_fallbacks": {
        "coding": [
          "gemini-3-flash-preview",
          "gemini-2.5-pro"
        ]
      }
    },
    "groq": {
      "api_key_env": "GROQ_API_KEY",
      "models": {
        "default": "openai/gpt-oss-120b",
        "coding": "openai/gpt-oss-120b",
        "fast": "openai/gpt-oss-20b"
      },
      "model_fallbacks": {
        "default": [
          "qwen/qwen3.8-27b",
          "openai/gpt-oss-20b"
        ],
        "coding": [
          "qwen/qwen3.8-27b",
          "openai/gpt-oss-20b"
        ],
        "fast": [
          "qwen/qwen3.8-27b",
          "openai/gpt-oss-120b"
        ]
      }
    },
    "cloudflare": {
      "api_key_env": "CLOUDFLARE_API_TOKEN",
      "account_id": "",
      "models": {
        "default": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
        "coding": "@cf/qwen/qwen2.5-coder-32b-instruct",
        "fast": "@cf/zai-org/glm-4.7-flash"
      },
      "model_fallbacks": {
        "default": [
          "@cf/qwen/qwen3.8-27b",
          "@cf/zai-org/glm-4.7-flash"
        ],
        "coding": [
          "@cf/qwen/qwen3.8-27b",
          "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
        ],
        "fast": [
          "@cf/qwen/qwen3.8-27b",
          "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
        ]
      }
    },
    "ollama": {
      "api_key_env": "OLLAMA_API_KEY",
      "zdr": {
        "enabled": false
      },
      "models": {
        "default": "SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M",
        "coding": "SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M",
        "fast": "SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M"
      }
    }
  },
  "engine": {
    "max_turns": 45,
    "request_timeout_s": 3600,
    "max_concurrent_tasks": 4,
    "max_queued_tasks": 12,
    "max_duration_s": 2200,
    "temperature": 0.7,
    "budget_limit_usd": 2.5,
    "approval_policy": "high_risk"
  },
  "exec": {
    "deny_args": [
      "python -c",
      "python3 -c",
      "py -c",
      "node -e",
      "node --eval",
      "node -p",
      "npm exec",
      "npx",
      "npm install",
      "npm i",
      "npm ci",
      "pip install",
      "pip uninstall",
      "pip wheel",
      "git push",
      "git commit",
      "git clean",
      "git reset",
      "git checkout",
      "git switch",
      "git restore",
      "git rm",
      "git config",
      "git rebase",
      "git merge",
      "git pull",
      "git fetch",
      "git clone",
      "git apply",
      "git stash",
      "git tag",
      "git branch -d",
      "git branch -D",
      "git -C",
      "git --git-dir",
      "git --work-tree",
      "--git-dir",
      "--work-tree",
      "git worktree",
      "git checkout-index",
      "git archive",
      "git show",
      "git remote",
      "sudo",
      "rm",
      "del",
      "format",
      "shutdown",
      "reboot",
      "curl",
      "wget",
      "iex",
      "invoke-expression",
      ".."
    ]
  },
  "app": {
    "referer": "https://github.com/kubainter/botex-harness"
  },
  "analytics": {
    "digest_enabled": false,
    "digest_provider": "",
    "digest_model": ""
  },
  "pricing": {
    "max_input_per_mtok": 2,
    "max_output_per_mtok": 4,
    "paid_consent_required": false,
    "paid_allowlist": []
  },
  "rate_limits": {
