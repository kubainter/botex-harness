  },
  "memory": {
    "recall": {
      "ollama": {
        "model": "qwen2.5:3b",
        "enabled": true,
        "timeout_s": 12
      },
      "nvidia": {
        "model": "nvidia/nemotron-3.5-lightning-30b-a3b",
        "enabled": true,
        "timeout_s": 12
      },
      "gemini": {
        "model": "gemini-2.5-flash",
        "enabled": true,
        "timeout_s": 10
      },
      "openrouter_free": {
        "model": "nvidia/nemotron-3.5-lightning:free",
        "enabled": true,
        "timeout_s": 10
      },
      "hedge_s": 4,
      "cache_ttl_s": 300,
