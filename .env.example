# BoteX environment template — copy to `.env` next to server.py and fill in.
# `.env` is gitignored; never commit real keys.
#
# Key resolution order: explicit per-call key > process env > this .env >
# custom paths.env_file > secrets.* in botex.config.local.json.
# Provider key env names come from providers.<name>.api_key_env in
# botex.config.json / botex/server/config.py DEFAULTS.

# ── Provider API keys ──────────────────────────────────────────────────────

# OpenRouter (paid models + :free variants)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# OpenRouter free-tier preset (providers.openrouter-free) — separate slot so
# the free preset can use a different key than paid openrouter.
# OPENROUTER_API_FREE_KEY=sk-or-v1-...

# NVIDIA NIM (integrate.api.nvidia.com)
# https://build.nvidia.com
# NVIDIA_API_KEY=nvapi-...
# NVAPI_KEY=nvapi-...            # accepted fallback

# Google AI Studio / Gemini (OpenAI-compatible endpoint)
# https://aistudio.google.com
# GEMINI_API_KEY=AIza...
# GOOGLE_API_KEY=AIza...         # fallback alias — either one works

# GroqCloud — OpenAI-compatible, free plan is per-model RPM/RPD/TPM/TPD
# https://console.groq.com/keys
# GROQ_API_KEY=gsk_...

# Cloudflare Workers AI — needs BOTH a token and the account id.
# Token: https://dash.cloudflare.com/profile/api-tokens
#   (permission: Account > Workers AI > Read + Edit)
# CLOUDFLARE_API_TOKEN=...
# CF_API_TOKEN=...               # fallback alias
# CLOUDFLARE_ACCOUNT_ID=...      # alternatively set providers.cloudflare.account_id
#                                # in botex.config(.local).json — never commit it

# Ollama / local Bielik — loopback endpoint, key is a placeholder only.
# OLLAMA_API_KEY=ollama

# ── Runtime ────────────────────────────────────────────────────────────────

# Default provider for calls that omit one. Note: POST /api/tasks and MCP
# delegation require an explicit provider per call; BOTEX_PROVIDER only
# exempts REST callers server-side.
# BOTEX_PROVIDER=openrouter-free

# Path to a non-default env file (overrides the .env next to server.py).
# BOTEX_ENV_FILE=/abs/path/to/custom.env

# Cloud gateway: remote URL + token for the PWA/REST client.
# BOTEX_CLOUD_URL=https://botex.example.com
# BOTEX_CLOUD_TOKEN=...

# SSE/WS server access control. Unset = loopback-only unauthenticated;
# remote access fails closed unless a token/hash is configured.
# BOTEX_ACCESS_TOKEN=...
# BOTEX_ACCESS_TOKEN_HASH=sha256:...   # preferred over the raw token
# BOTEX_STRICT_AUTH=1                  # fail closed even on loopback

# Telegram alerts on task failures (optional).
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...
# TELEGRAM_SILENT=1                    # deliver without sound/vibration
# TELEGRAM_ALERT_ON_SUCCESS=1          # also notify on DONE (off by default)
