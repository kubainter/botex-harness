{
  "providers": {
    "openrouter": {
      "default": true,
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "extra_body": {
        "provider": {
          "data_collection": "deny"
        },
        "reasoning": {
          "max_tokens": 9000
        }
      },
      "zdr": {
        "enabled": true,
        "deny_patterns": [
          ":free",
          "openrouter/free"
        ]
      },
      "denylist": [],
      "profile_denylists": {},
      "decisions_models": [
        "typesafe/jev-*",
        "~typesafe/jev-*"
      ],
      "models": {
        "default": "openrouter/auto",
        "auto-beta": "openrouter/auto-beta",
        "coding": "openrouter/pareto-code",
        "review": "anthropic/claude-sonnet-4",
        "fast": "google/gemini-2.5-flash"
      },
      "model_fallbacks": {
        "default": [
          "anthropic/claude-sonnet-4",
          "qwen/qwen3-coder",
          "deepseek/deepseek-v3.2"
        ],
        "auto-beta": [
          "anthropic/claude-sonnet-4",
          "qwen/qwen3-coder",
          "deepseek/deepseek-v3.2"
        ],
        "coding": [
          "anthropic/claude-sonnet-4",
          "qwen/qwen3-coder",
          "deepseek/deepseek-v3.2"
        ],
        "review": [
          "openai/gpt-5.4",
          "google/gemini-2.5-pro",
          "deepseek/deepseek-r1"
        ],
        "fast": [
          "qwen/qwen3-coder-flash",
          "openai/gpt-4o-mini",
          "deepseek/deepseek-v3.2"
        ]
      }
    },
    "nvidia": {
      "default": false,
      "base_url": "https://integrate.api.nvidia.com/v1",
      "api_key_env": "NVIDIA_API_KEY",
      "extra_body": {},
      "denylist": [],
      "profile_denylists": {},
      "capabilities": {},
      "models": {
        "default": "meta/llama-3.2-11b-vision-instruct",
        "coding": "poolside/laguna-xs-2.1",
        "fast": "meta/llama-3.2-11b-vision-instruct"
      }
    },
    "openrouter-free": {
      "default": false,
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_FREE_KEY",
      "extra_body": {
        "provider": {
          "data_collection": "allow"
        },
        "reasoning": {
          "max_tokens": 4000
        }
      },
      "zdr": {
        "enabled": false
      },
      "retry": {
        "enabled": true,
        "max_waits": 3,
        "max_wait_s": 90.0,
        "jitter_s": 1.5
      },
      "denylist": [],
      "profile_denylists": {},
      "models": {
        "default": "nvidia/nemotron-3-ultra-550b-a55b:free",
        "coding": "cohere/north-mini-code:free",
        "fast": "google/gemma-4-31b-it:free"
      },
      "model_fallbacks": {
        "default": [
          "nvidia/nemotron-3.5-lightning:free",
          "qwen/qwen3.8-27b:free"
        ],
        "coding": [
          "poolside/laguna-s-2.1:free",
          "qwen/qwen3.8-27b:free"
        ],
        "fast": [
          "nvidia/nemotron-3.5-lightning:free",
          "liquid/lfm-2.5-2.6b:free"
        ]
      }
    },
    "google": {
      "default": false,
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
      "api_key_env": "GEMINI_API_KEY",
      "stream": true,
      "extra_body": {
        "reasoning_effort": "low"
      },
      "zdr": {
        "enabled": false
      },
      "retry": {
        "enabled": true,
        "max_waits": 2,
        "max_wait_s": 60.0,
        "jitter_s": 1.5
      },
      "denylist": [
        "*image*", "*imagen*", "*veo*",
        "*embedding*", "*gecko*",
        "*tts*", "*speech*", "*audio*", "*transcribe*", "*lyria*", "*music*", "*chirp*",
        "*realtime*", "*-live*", "*antigravity*",
        "*gemma*", "*paligemma*", "*codegemma*",
        "*robotics*", "*rt-*", "*computer-use*", "*deep-research*",
        "*nano*", "*banana*",
        "*learnlm*", "*aqa*", "*medlm*", "*med-gemini*",
        "*bison*", "*gemini-1.0*", "*gemini-pro*", "*gemini-ultra*",
        "tunedmodels/*", "*tuned*",
        "*-exp*", "*-experimental*"
      ],
      "profile_denylists": {},
      "capabilities": {
        "gemini-2.5-flash": {"supports_tools": true, "context_length": 1048576},
        "gemini-2.5-pro": {"supports_tools": true, "context_length": 1048576},
        "gemini-2.5-flash-lite": {"supports_tools": true, "context_length": 1048576}
      },
      "pricing_overrides": {
        "gemini-2.5-pro": {"input": 1.25, "output": 10.0},
        "gemini-2.5-flash": {"input": 0.30, "output": 2.50},
        "gemini-2.5-flash-lite": {"input": 0.10, "output": 0.40}
      },
      "models": {
        "default": "gemini-2.5-flash",
        "coding": "gemini-2.5-pro",
        "fast": "gemini-2.5-flash-lite"
      },
      "model_fallbacks": {
        "default": [
          "gemini-2.5-flash-lite"
        ],
        "coding": [
          "gemini-2.5-flash"
        ],
        "fast": [
          "gemini-2.5-flash"
        ]
      }
    },
    "ollama": {
      "default": false,
      "base_url": "http://127.0.0.1:11434/v1",
      "api_key_env": "OLLAMA_API_KEY",
      "api_key_fallback": "ollama",
      "local": true,
      "extra_body": {},
      "zdr": {
        "enabled": false
      },
      "denylist": [],
      "profile_denylists": {},
      "models": {
        "default": "SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M",
        "coding": "SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M",
        "fast": "SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M"
      }
    }
  },
  "engine": {
    "max_turns": 45,
    "max_tokens": 8000,
    "reasoning_max_tokens": 16000,
    "request_timeout_s": 3600,
    "max_concurrent_tasks": 4,
    "max_queued_tasks": 12,
    "task_result_ttl_s": 3600,
    "max_duration_s": 2200,
    "max_task_duration_s": 0,
    "temperature": 0.7,
    "budget_limit_usd": 2.5,
    "default_mode": "edit",
    "allow_destructive": false,
    "require_read_before_write": true,
    "approval_policy": "high_risk",
    "mode_profiles": {
      "readonly": "fast",
      "edit": "",
      "destructive": "coding",
      "full": "coding"
    },
    "mode_max_turns": {
      "readonly": 30,
      "edit": 0,
      "destructive": 0,
      "full": 0
    },
    "denylist": [],
    "profile_denylists": {}
  },
  "net": {
    "enabled": true,
    "policy": "caller",
    "allowed_hosts": [
      "docs.openrouter.ai",
      "openrouter.ai"
    ],
    "allowed_urls": [],
    "timeout_s": 20,
    "max_bytes": 200000,
    "max_requests_per_task": 5,
    "max_redirects": 3
  },
  "exec": {
    "enabled": false,
    "allowlist": [
      "pytest",
      "python",
      "py",
      "ruff",
      "mypy",
      "node",
      "npm",
      "git",
      "pip"
    ],
    "deny_args": [
      "python -c",
      "python3 -c",
      "py -c",
      "node -e",
      "npm exec",
      "npx",
      "pip install",
      "pip uninstall",
      "git push",
      "git commit",
      "git clean",
      "git reset",
      "git checkout",
      "git restore",
      "git rm",
      "git config",
      "git rebase",
      "git merge",
      "git pull",
      "git fetch",
      "git clone",
      "git apply",
      "git stash",
      "git tag",
      "git branch -d",
      "git branch -D",
      "sudo",
      "rm",
      "del",
      "format",
      "shutdown",
      "reboot",
      "curl",
      "wget",
      "iex",
      "invoke-expression"
    ],
    "timeout_s": 120,
    "max_output_bytes": 20000
  },
  "context_guard": {
    "enabled": true,
    "threshold_bytes": 2048,
    "max_preview_bytes": 3072,
    "auto_vault_logs": true,
    "vault_retention_days": 3
  },
  "paths": {
    "snapshot_dir": ".snapshots",
    "snapshot_auto_prune": true,
    "snapshot_max_age_days": 7,
    "snapshot_max_total_mb": 50,
    "global_memory_dir": "~/.botex/memory",
    "analytics_file": ".agent_analytics.json",
    "catalog_file": ".model_pricing.json",
    "env_file": ""
  },
  "app": {
    "referer": "https://github.com/kubainter/botex-harness"
  },
  "analytics": {
    "store_full_text": false,
    "preview_chars": 160
  },
  "ui": {
    "language": "auto"
  },
  "pricing": {
    "enabled": true,
    "max_input_per_mtok": 2.0,
    "max_output_per_mtok": 4.0,
    "on_unknown": "allow",
    "cache_ttl_hours": 24
  },
  "catalog": {
    "enabled": true,
    "cache_file": ".model_pricing.json",
    "cache_path": ".model_pricing.json",
    "ttl_hours": 24.0,
    "cache_ttl_hours": 24,
    "timeout_s": 10.0,
    "on_unknown": "allow"
  },
  "wallet": {
    "enabled": true,
    "cache_ttl_s": 60.0,
    "timeout_s": 10.0,
    "auto_check": false,
    "min_balance_usd": 0.0
  },
  "analytics": {
  "digest_enabled": true,
  "digest_interval_s": 3600,
  "digest_provider": "ollama",
  "digest_model": "bielik-direct:latest"
  }
}